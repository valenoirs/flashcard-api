APLICATION_NAME=flashcard
APPLICATION_ENV=development
APPLICATION_VERSION=1.0.0
APPLICATION_PORT=5001

DB_CONNECTION_STRING=postgres://lucky:lucky@localhost:5433/flashcard?sslmode=disable
DB_SCHEMA_NAME=flashcard_schema
DB_MAX_LIFETIME=300s
DB_MAX_IDLE_TIME=300s
DB_MAX_IDLE_CONNECTION=10
DB_MAX_OPEN_CONNECTION=100
DB_SLOW_QUERY_THRESHOLD=100ms

# if CORS_ALLOWED_ORIGIN=*, set CORS_ALLOW_CREDENTIAL=false
CORS_ALLOWED_ORIGIN=localhost:3000
CORS_ALLOWED_METHOD=GET,POST,PUT,DELETE
CORS_ALLOWED_HEADER=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIAL=true
CORS_MAX_AGE=86400

SNOWFLAKE_NODE_ID=1
